---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolTip from '../components/Tooltip.astro'
import { SITE_TITLE, SITE_DESCRIPTION, stack, projects } from '../consts';
import imprivataLogo from '../icons/imprivata-logo.svg'
import upsLogo from '../icons/ups.svg'
import zeusLogo from '../icons/zeus.svg'
import ccss from '../icons/ccss-azul.png'
import tecLogo from '../icons/itcr2.svg'
import ctplogo from '../icons/ctpmn.svg'
import whatsappLogo from '../icons/whatsappLogo.svg'
import mailIcon from '../icons/mailIcon.svg'
import avatar from '../images/yo.jpeg'
import '../styles/pages/index/base.css'
import '../styles/pages/index/home.css'
import '../styles/pages/index/about.css'
import '../styles/pages/index/experience.css'
import '../styles/pages/index/projects.css'
import '../styles/pages/index/education.css'
import '../styles/pages/index/stack.css'
import '../styles/pages/index/responsive.css'
---

<!doctype html>
<html lang='en'>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image='/banner.webp' />
	</head>
	<body>
		<span class='glow'/>
		<Header title={SITE_TITLE} />
		<main class='portfolio'>
			<section class='home'>
				<article class='title'>
					<br>
					<h1>Taylor Hernández Córdoba</h1>
					<h1></h1>
					<h2>Software Engineer</h2>
					<p class="caption">
						Always learning about new paradigms and technologies to apply right solution in the right place.
					</p>
					<br>
					<figure class="avatar">
						<Image src={avatar}	alt="Photo of Taylor Hernandez" width={200} height={200} />
					</figure>
				</article>
			</section>

			<section class="about">
				<div class="about__description">
					<ul class="social-links">
						<li>
							<a target="_blank" href="mailto:taylor.hernandez.c20@gmail.com">
								<Image src={mailIcon} alt='Mail Logo' height={45} />
							</a>
						</li>
						<li>
							<a target="_blank" href="https://wa.link/5qfmwt">
								<Image src={whatsappLogo} alt='Whatsapp Logo' height={42} />
							</a>
						</li>
					</ul>
					<p>
						Hi there! I'm Taylor S. Hernández a software developer with around <b>2 years</b> of experience building user-friendly applications. Throughout my journey, I've <b>collaborated</b> with my co-workers in their duties across diverse areas like backend, frotend, automation, and database management, <b>learning</b> a lot from them. I <b>constantly explore</b> new technologies and resources to build smooth and scalable apps.
					</p>
				</div>
			</section>

			<section class='experiences'>
				<div class="experiences_title">
					<h2 class='exp_subtitle'>Experience</h2>
					<p class="open-to-work">Open to work</p>
				</div>
				<br>
				<article class='experience'>
					<div class='experience__title'>
						<h3>CCSS
							<Image src={ccss} alt='CCSS Logo' height={38} />
						</h3>
						<span></span>
						<p class='experience__role'>CCSS Hospital San Vicente de Paul - Full Stack Engineer</p>
					</div>

					<p class='experience__date'><time datetime='2025-05-01'>May 2025</time> - <time datetime='2026-04-07'>Present</time></p>
					<ul class='experience__tasks'>
						<li><p>Engineered full-stack solutions using <b>C#</b> (<b>.NET</b>) and <b>Angular</b>/<b>TypeScript</b> for healthcare systems.</p></li>
						<li><p>Designed and maintained <b>ETL</b> workflows for integrating medical and administrative data.</p></li>
						<li><p>Managed <b>SQL Server</b> databases ensuring secure and scalable storage of sensitive data.</p></li>
						<li><p>Deployed and monitored applications using <b>Azure DevOps</b>, <b>Docker</b>, <b>Kubernetes</b>, and <b>Grafana</b> to ensure reliability and observability.</p></li>
					</ul>
				</article>
				<br>
				<article class='experience'>
					<div class='experience__title'>
						<h3>Imprivata
							<Image src={imprivataLogo} alt='Imprivata Logo' height={38} />
						</h3>
						<span></span>
						<p class='experience__role'>Imprivata - Software Engineer Intern</p>
					</div>

					<p class='experience__date'><time datetime='2024-02-20'>February 2024</time> - <time datetime='2024-07-01'>July 2024</time></p>
					<ul class='experience__tasks'>
						<li><p>Built backend automation processes using <b>Java</b>, <b>Spring Boot</b>, and <b>PostgreSQL</b>.</p></li>
						<li><p>Automated service setup using <b>Spring CLI</b>, <b>Bash</b>, <b>SSH</b>, and <b>Docker</b>.</p></li>
						<li><p>Developed testing suites using <b>JUnit</b>, <b>Mockito</b>, and <b>Postman</b>.</p></li>
						<li><p>Worked in <b>Linux</b> environments managing deployments and troubleshooting.</p></li>
					</ul>
				</article>
				<br>
				<article class='experience'>
					<div class='experience__title'>
						<h3>Zeus TEC
							<Image src={zeusLogo} alt='Zeus Logo' height={38} />
						</h3>
						<span></span>
						<p class='experience__role'>Zeus Technology - Freelance Software Developer</p>
					</div>

					<p class='experience__date'><time datetime='2022-09-01'>September 2022</time> - <time datetime='2023-02-01'>February 2023</time></p>
					<ul class='experience__tasks'>
						<li><p>Hired under contract to design and build a custom system from scratch for business data workflows.</p></li>
						<li><p>Built full-stack applications using <b>Python</b> (<b>Flask</b>) for backend services and <b>Angular</b> for dynamic front-end interfaces.</p></li>
						<li><p>Automated data workflows and developed APIs for system integration.</p></li>
						<li><p>Ensured data integrity and optimized processing pipelines.</p></li>
					</ul>
				</article>
				<br>
				<article class='experience'>
					<div class='experience__title'>
						<h3>UPS
							<Image src={upsLogo} alt='UPS Logo' height={38} />
						</h3>
						<span></span>
						<p class='experience__role'>UPS - Software Developer</p>
					</div>

					<p class='experience__date'><time datetime='2019-10-07'>October 2019</time> - <time datetime='2020-03-01'>March 2020</time></p>
					<ul class='experience__tasks'>
						<li><p>Automated end-to-end data workflows using <b>C#</b> and <b>JSON</b>, reducing processing time by over 30%.</p></li>
						<li><p>Designed and built <b>ETL</b> pipelines in <b>SQL Server</b> to ingest, validate, and transform large shipment and financial datasets.</p></li>
						<li><p>Developed integration services to synchronize data between internal systems and third-party applications, enabling near real-time visibility.</p></li>
						<li><p>Created <b>Excel</b> macros to automate repetitive reporting tasks and data preparation processes for business users.</p></li>
						<li><p>Integrated processed data into <b>Power BI</b> dashboards, enabling data visualization and supporting operational decision-making.</p></li>
					</ul>
				</article>
			
			</section>

			<section class='projects'>
				<span class='glow1'/>
				<h2 class='subtitle'>Projects</h2>
				<div class="major-container">
					<div class='projects__container'>
						{
							projects.slice(2,4).map(project => (
								<article class="project" >
									<a href={project.url} target="_blank">
										<div class="project__info">
											<h3 class="project__title">
												{project.name}
												<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
													<path d="M20 4V8M20 4H16M20 4L14 10M18 11V16C18 17.1046 17.1046 18 16 18H8C6.89543 18 6 17.1046 6 16V8C6 6.89543 6.89543 6 8 6H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
												</svg>
											</h3>
											<p class="project__description" set:html={project.description}></p>
										</div>
										<figure class="project__image">
											<Image src={project.image} alt='Colors Kit logo' height={150} />
										</figure>
									</a>
								</article>
							))
						}
					</div>
					<div class='projects__container'>
						{
							projects.slice(0,2).map(project => (
								<article class="project" >
									<a href={project.url} target="_blank">
										<div class="project__info">
											<h3 class="project__title">
												{project.name}
												<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
													<path d="M20 4V8M20 4H16M20 4L14 10M18 11V16C18 17.1046 17.1046 18 16 18H8C6.89543 18 6 17.1046 6 16V8C6 6.89543 6.89543 6 8 6H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
												</svg>
											</h3>
											<p class="project__description" set:html={project.description}></p>
										</div>
										<figure class="project__image">
											<Image src={project.image} alt='Colors Kit logo' height={150} />
										</figure>
									</a>
								</article>
							))
						}
					</div>
				</div>
			</section>


			<section class="experiences">
				<div class="education_container">
					<div class="education_title">
						<h2 class="exp_subtitle">Education</h2>
						<br />
						<article class="experience">
						  <div class="experience__title">
							<h3>CTPMN
							  <Image src={ctplogo} alt="CTPMN Logo" height={50} />
							</h3>
							<span></span>
							<p class="experience__role">CTP de Mercedes Norte <br> Associate's Degree in Software Development</p>
						  </div>
						  <p class="experience__date">
							<time datetime="2017-02-05">February 2017</time> - <time datetime="2019-12-15">December 2019</time>
						  </p>
						  Graduated with <b>Honors</b>
						</article>
					  </div>
					
					<div class="education_title">
					<article class="experience">
					  <div class="education__title">
						<h3>ITCR
						  <Image src={tecLogo} alt="ITCR Logo" height={50} />
						</h3>
						<span></span>
						<p class="experience__role">Instituto Tecnologico de Costa Rica <br> Bachelor's Degree in Computer Science</p>
					  </div>
					  <p class="experience__date">
						<time datetime="2020-02-07">February 2021</time> - <time datetime="2024-09-05">December 2024</time>
					  </p>
						<p>
						Graduated with <b>Honors</b>
						</p>
					  
					</article>
				  </div>
			  
				  
				</div>
			  </section>

			<section class='stacks'>
				<h2 class='subtitle'>Stack</h2>
				<ul>
					{ stack.map(stack => (
						<li class='stack' style={{ '--background-dif': stack.color }} tool-tip>
							<p class="stack__name">{stack.name}</p>
							<ToolTip aria-hidden='true'>{stack.name}</ToolTip>
							<span class={`icon-${stack.name}`} />
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
